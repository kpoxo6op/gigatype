[Unit]
Description=GigaType local Russian voice typing
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/gigatype daemon
ExecStopPost=/usr/bin/rm -f %t/gigatype-recording.wav %t/gigatype-transcribing
Restart=on-failure
RestartSec=2
Environment=GIGATYPE_MODEL=%h/.local/share/gigatype/models/gigaam-v3-e2e-rnnt

[Install]
WantedBy=default.target
